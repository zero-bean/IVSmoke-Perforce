#include "/Engine/Private/Common.ush"
#include "/Plugin/IVSmoke/IVSmokeCommon.ush"

// ============================================================================
// Thread Group Size
// ============================================================================

#ifndef THREADGROUP_SIZE_X
#define THREADGROUP_SIZE_X 8
#endif
#ifndef THREADGROUP_SIZE_Y
#define THREADGROUP_SIZE_Y 8
#endif

// Maximum volumes to process per pixel (stack array limit)
#define MAX_VOLUME_INTERSECTIONS 64

// ============================================================================
// Shader Parameters
// ============================================================================

// Output (Dual Render Target)
RWTexture2D<float4> SmokeAlbedoTex;
RWTexture2D<float4> SmokeMaskTex;

// Input Textures
Texture3D<half> NoiseVolume;
float NoiseUVMul;

// Samplers
SamplerState LinearBorder_Sampler;
SamplerState LinearRepeat_Sampler;

// Time
float ElapsedTime;

// Viewport
uint2 TexSize;
float2 ViewportSize;
float2 ViewRectMin;

// Camera
float3 CameraPosition;
float3 CameraForward;
float3 CameraRight;
float3 CameraUp;
float TanHalfFOV;
float AspectRatio;

// Ray Marching
int MaxSteps;

// Multi-Volume Data
StructuredBuffer<FVolumeGPUData> VolumeDataBuffer;
uint NumActiveVolumes;

// Packed Textures
int PackedInterval;
Texture3D<float> PackedVoxelAtlas;
Texture3D<float> PackedHoleAtlas;
int3 VoxelTexSize;
int3 HoleTexSize;
int3 PackedHoleTexSize;
int3 HoleAtlasCount;

// Scene Depth
float4 InvDeviceZToWorldZTransform;

// Global Smoke Parameters
float GlobalAbsorption;
float SmokeSize;
float3 WindDirection;
float VolumeRangeOffset; //0.1
float VolumeEdgeNoiseFadeOffset; //0.04
float VolumeEdgeFadeSharpness; //3.5

// Rayleigh Scattering
float3 LightDirection;
float3 LightColor;
float ScatterScale;
float ScatteringAnisotropy;

// Self-Shadowing (Light Marching)
int LightMarchingSteps;
float LightMarchingDistance;
float LightMarchingExpFactor;
float ShadowAmbient;

// ============================================================================
// External Shadowing (CSM - Cascaded Shadow Maps)
// ============================================================================
// Note: CSM is always enabled when external shadowing is used.
// VSM (Variance Shadow Maps) can be toggled for soft/hard shadows.

#define CSM_MAX_CASCADES 8

int NumCascades;
Texture2DArray<float> CSMDepthTextureArray;
Texture2DArray<float2> CSMVSMTextureArray;
SamplerState CSMSampler;
float4x4 CSMViewProjectionMatrices[CSM_MAX_CASCADES];
float4 CSMSplitDistances[2];  // 8 floats packed into 2 float4s (SHADER_PARAMETER_SCALAR_ARRAY)
float3 CSMCameraPosition;
float CascadeBlendRange;
float4 CSMLightCameraPositions[CSM_MAX_CASCADES];  // xyz = position, w = unused
float4 CSMLightCameraForwards[CSM_MAX_CASCADES];   // xyz = forward direction, w = unused

// Helper to unpack split distances from float4 array
float GetCSMSplitDistance(int CascadeIndex)
{
	int VecIndex = CascadeIndex / 4;
	int Component = CascadeIndex % 4;
	return CSMSplitDistances[VecIndex][Component];
}

// VSM parameters
int bEnableVSM;
float VSMMinVariance;
float VSMLightBleedingReduction;

// Shadow common parameters
float ShadowDepthBias;
float ExternalShadowAmbient;

// Temporal (for TAA integration)
uint FrameNumber;

// Include CSM sampling functions (must come after uniform declarations)
#include "/Plugin/IVSmoke/IVSmokeCSM.usf"

// ============================================================================
// Helper Functions
// ============================================================================

/**
 * Spatiotemporal Blue Noise lookup (from View Uniform Buffer).
 * Returns uniformly distributed value in [0, 1) with blue noise distribution.
 * Blue noise is visually superior to white noise - same variance but less perceptible.
 */
float BlueNoiseScalar(uint2 ScreenCoord, uint FrameIndex)
{
	uint3 WrappedCoordinate = uint3(ScreenCoord, FrameIndex) & View.BlueNoiseModuloMasks;
	uint3 TextureCoordinate = uint3(WrappedCoordinate.x, WrappedCoordinate.z * View.BlueNoiseDimensions.y + WrappedCoordinate.y, 0);
	return View.BlueNoiseScalarTexture.Load(TextureCoordinate, 0).x;
}

/**
 * Sample noise at a world position.
 *
 * @param Position   World space position to sample
 * @return           Noise value [0, 1]
 */
float GetNoise(float3 WorldPos)
{
	float3 uvw = WorldPos / SmokeSize;
	uvw *= NoiseUVMul;
	uvw -= WindDirection * ElapsedTime;
	return NoiseVolume.SampleLevel(LinearRepeat_Sampler, uvw, 0);
}

float3 GetVoxelUVW(float3 WorldPos, uint VolumeIdx, int TexZSize)
{
	FVolumeGPUData Vol = VolumeDataBuffer[VolumeIdx];
	float3 uvw = (WorldPos - Vol.VolumeWorldAABBMin) / (Vol.VolumeWorldAABBMax - Vol.VolumeWorldAABBMin);
	int AtlasTexZSize = TexZSize * NumActiveVolumes + PackedInterval * (NumActiveVolumes - 1);
	int zMinTex = (TexZSize + PackedInterval) * VolumeIdx;
	int zMaxTex = zMinTex + TexZSize;
	float zMinUV = (float) zMinTex / AtlasTexZSize;
	float zMaxUV = (float) zMaxTex / AtlasTexZSize;
	uvw.z = lerp(zMinUV, zMaxUV, uvw.z);
	return uvw;
}

float3 GetHoleUVW(float3 WorldPos, uint VolumeIdx)
{
	FVolumeGPUData Vol = VolumeDataBuffer[VolumeIdx];
	float3 uvw = (WorldPos - Vol.VoxelWorldAABBMin) / (Vol.VoxelWorldAABBMax - Vol.VoxelWorldAABBMin);
	uvw = saturate(uvw);
	int3 HoleAtlasID;
	HoleAtlasID.x = VolumeIdx % HoleAtlasCount.x;
	HoleAtlasID.y = (VolumeIdx / HoleAtlasCount.x) % HoleAtlasCount.y;
	HoleAtlasID.z = VolumeIdx / (HoleAtlasCount.x * HoleAtlasCount.y);
	int3 MinTexPos = HoleAtlasID * (HoleTexSize + PackedInterval);
	int3 MaxTexPos = MinTexPos + HoleTexSize;
	float3 MinUV = (float3) MinTexPos / PackedHoleTexSize;
	float3 MaxUV = (float3) MaxTexPos / PackedHoleTexSize;
	uvw = lerp(MinUV, MaxUV, uvw);
	return uvw;
}
float GetHoleDensity(float3 WorldPos, uint VolumeIdx)
{
	float3 uvw = GetHoleUVW(WorldPos, VolumeIdx);
	return PackedHoleAtlas.Sample(LinearBorder_Sampler, uvw);
}

float GetVoxelDensity(float3 WorldPos, uint VolumeIdx)
{
	float3 uvw = GetVoxelUVW(WorldPos, VolumeIdx, VoxelTexSize.z);
	return PackedVoxelAtlas.Sample(LinearBorder_Sampler, uvw);
}

/**
 * Calculate final smoke density at a position for a specific volume.
 * Combines voxel density, edge falloff, and noise.
 *
 * @param Position    World space sample position
 * @param VolumeIdx   Index into VolumeDataBuffer
 * @return            Final density value
 */
float GetDensityForVolume(float3 Position, uint VolumeIdx)
{
	FVolumeGPUData Vol = VolumeDataBuffer[VolumeIdx];
	float VoxelDensity = GetVoxelDensity(Position, VolumeIdx);
	float Noise = GetNoise(Position);

	// Adjust density based on noise range (0.7 threshold works well for typical noise values)
	float CurDensity = saturate(0.7f - Noise) * VoxelDensity;
	CurDensity = saturate((CurDensity - VolumeRangeOffset) / (1 - VolumeRangeOffset));
	float InvDensity = saturate(1 - CurDensity);
	InvDensity = pow(InvDensity, VolumeEdgeFadeSharpness); // Higher = sharper voxel edge fade
	float NoiseWeight = 1 - InvDensity;
	NoiseWeight = saturate(NoiseWeight - VolumeEdgeNoiseFadeOffset);
	float result = Noise * NoiseWeight + CurDensity;
	return result * Vol.DensityScale;
}

// ============================================================================
// Self-Shadowing (Light Marching)
// ============================================================================

/**
 * Sample total density at a position from all intersecting volumes.
 * Used for light marching to calculate shadow transmittance.
 *
 * @param WorldPos      World space position to sample
 * @return              Total combined density from all volumes
 */
float SampleTotalDensityAtPosition(float3 WorldPos)
{
	float TotalDensity = 0.0;

	for (uint v = 0; v < NumActiveVolumes; v++)
	{
		FVolumeGPUData Vol = VolumeDataBuffer[v];

		// Check if position is within volume AABB
		if (all(WorldPos >= Vol.VolumeWorldAABBMin) && all(WorldPos <= Vol.VolumeWorldAABBMax))
		{
			float HoleDensity = GetHoleDensity(WorldPos, v);
			float Density = GetDensityForVolume(WorldPos, v) * HoleDensity;
			TotalDensity += Density;
		}
	}

	return TotalDensity;
}

/**
 * Calculate light transmittance by marching toward light source.
 * Uses exponential step distribution for better quality with fewer samples.
 * More samples near the surface, fewer far away (where they matter less).
 *
 * @param WorldPos          Current sample position
 * @param LightDir          Direction toward light (normalized)
 * @param MarchDistance     Distance to march (auto-calculated or user-specified)
 * @param Steps             Number of marching steps
 * @param ExpFactor         Exponential distribution factor (1.0 = uniform, higher = more near samples)
 * @return                  Transmittance [0,1] - 0=fully shadowed, 1=fully lit
 */
float MarchTowardLight(float3 WorldPos, float3 LightDir, float MarchDistance, int Steps, float ExpFactor)
{
	if (Steps <= 0)
	{
		return 1.0;  // Self-shadowing disabled
	}

	float LightTransmittance = 1.0;

	// Exponential distribution: exp(t * ExpFactor) maps [0,1] to [1, e^ExpFactor]
	// Normalize to [0,1] range for distance calculation
	float ExpDenom = exp(ExpFactor) - 1.0;
	float PrevDist = 0.0;

	for (int i = 1; i <= Steps; i++)
	{
		// Normalized position [0, 1]
		float t = (float)i / (float)Steps;

		// Exponential mapping: more samples near origin, fewer far away
		// ExpFactor = 1.0 → nearly uniform
		// ExpFactor = 2.0~3.0 → moderate concentration near origin
		// ExpFactor = 4.0+ → strong concentration near origin
		float CurrentDist = MarchDistance * (exp(t * ExpFactor) - 1.0) / ExpDenom;
		float StepSize = CurrentDist - PrevDist;

		float3 SamplePos = WorldPos + LightDir * CurrentDist;
		float Density = SampleTotalDensityAtPosition(SamplePos);

		if (Density > 0.0001)
		{
			LightTransmittance *= exp(-Density * StepSize * GlobalAbsorption);
		}

		// Early exit if fully shadowed
		if (LightTransmittance < 0.01)
		{
			return 0.0;
		}

		PrevDist = CurrentDist;
	}

	return LightTransmittance;
}

// ============================================================================
// Multi-Volume Ray Marching CS
// ============================================================================

[numthreads(THREADGROUP_SIZE_X, THREADGROUP_SIZE_Y, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint2 PixelCoord = DispatchThreadId.xy;

	// Bounds check (use TexSize for reduced resolution rendering)
	if (PixelCoord.x >= TexSize.x || PixelCoord.y >= TexSize.y)
	{
		return;
	}

	// Calculate screen position (use TexSize for UV calculation)
	float2 PixelUV = (float2(PixelCoord) + 0.5) / TexSize;
	float2 ScreenPos = PixelUV * 2.0 - 1.0;
	ScreenPos.y *= -1.0;

	// Reconstruct ray direction
	float3 RayDir = normalize(
		CameraForward
		+ ScreenPos.x * CameraRight * TanHalfFOV * AspectRatio
		+ ScreenPos.y * CameraUp * TanHalfFOV
	);
	float3 RayOrigin = CameraPosition;

	// ============================================================================
	// Scene Depth (ratio-based coordinate for reduced resolution)
	// ============================================================================

	int3 ScenePixelCoord = int3(0, 0, 0);
	ScenePixelCoord.x = ceil((float)PixelCoord.x / TexSize.x * ViewportSize.x + ViewRectMin.x);
	ScenePixelCoord.y = ceil((float)PixelCoord.y / TexSize.y * ViewportSize.y + ViewRectMin.y);
	float DeviceZ = SceneTexturesStruct.SceneDepthTexture.Load(ScenePixelCoord).r;
	float SceneDepthWorld = DeviceZ * InvDeviceZToWorldZTransform.x
		+ InvDeviceZToWorldZTransform.y
		+ 1.0 / (DeviceZ * InvDeviceZToWorldZTransform.z - InvDeviceZToWorldZTransform.w);

	float ViewDirDot = dot(RayDir, CameraForward);
	float SceneRayDistance = SceneDepthWorld / max(ViewDirDot, 0.001);
	SceneRayDistance -= 5.0; // Depth bias

	// ============================================================================
	// Compute Global AABB (union of all volumes)
	// ============================================================================

	float3 GlobalAABBMin = float3(1e10, 1e10, 1e10);
	float3 GlobalAABBMax = float3(-1e10, -1e10, -1e10);

	for (uint v = 0; v < NumActiveVolumes; v++)
	{
		FVolumeGPUData Vol = VolumeDataBuffer[v];
		GlobalAABBMin = min(GlobalAABBMin, Vol.VolumeWorldAABBMin);
		GlobalAABBMax = max(GlobalAABBMax, Vol.VolumeWorldAABBMax);
	}

	// Global AABB diagonal length for fixed step size calculation
	float3 GlobalAABBSize = GlobalAABBMax - GlobalAABBMin;
	float GlobalDiagonal = length(GlobalAABBSize);

	// ============================================================================
	// Ray-GlobalAABB Intersection for consistent ray bounds
	// ============================================================================

	float globalTMin, globalTMax;
	if (!RayBoxIntersection(RayOrigin, RayDir, GlobalAABBMin, GlobalAABBMax, globalTMin, globalTMax))
	{
		SmokeAlbedoTex[PixelCoord] = float4(0.0, 0.0, 0.0, 0.0);
		SmokeMaskTex[PixelCoord] = float4(0.0, 0.0, 0.0, 0.0);
		return;
	}

	globalTMin = max(0.0, globalTMin);
	globalTMax = min(SceneRayDistance, globalTMax);

	if (globalTMax <= globalTMin)
	{
		SmokeAlbedoTex[PixelCoord] = float4(0.0, 0.0, 0.0, 0.0);
		SmokeMaskTex[PixelCoord] = float4(0.0, 0.0, 0.0, 0.0);
		return;
	}

	// ============================================================================
	// Collect Individual Volume Intersections (for per-sample volume checks)
	// ============================================================================

	FVolumeIntersection intersections[MAX_VOLUME_INTERSECTIONS];
	uint numIntersections = 0;

	for (uint vi = 0; vi < NumActiveVolumes && numIntersections < MAX_VOLUME_INTERSECTIONS; vi++)
	{
		FVolumeGPUData Vol = VolumeDataBuffer[vi];

		float tNear, tFar;
		if (RayBoxIntersection(RayOrigin, RayDir, Vol.VolumeWorldAABBMin, Vol.VolumeWorldAABBMax, tNear, tFar))
		{
			tNear = max(0.0, tNear);
			tFar = min(SceneRayDistance, tFar);

			if (tFar > tNear)
			{
				intersections[numIntersections].VolumeIndex = vi;
				intersections[numIntersections].tNear = tNear;
				intersections[numIntersections].tFar = tFar;
				numIntersections++;
			}
		}
	}

	// Early exit if no intersections
	if (numIntersections == 0)
	{
		SmokeAlbedoTex[PixelCoord] = float4(0.0, 0.0, 0.0, 0.0);
		SmokeMaskTex[PixelCoord] = float4(0.0, 0.0, 0.0, 0.0);
		return;
	}

	// ============================================================================
	// Unified Ray March
	// ============================================================================
	//
	// Front-to-back ray marching with pre-multiplied alpha accumulation.
	// Output is pre-multiplied: AccumulatedColor already contains transmittance weighting.
	// Composite formula: FinalColor = SceneColor * Transmittance + AccumulatedColor
	//
	// ============================================================================

	float3 AccumulatedColor = float3(0.0, 0.0, 0.0);
	float Transmittance = 1.0;
	float RayLength = globalTMax - globalTMin;
	float FirstHitDepth = 0.0;  // Track depth for particle sorting

	// Step size calculation:
	// Use FIXED step size based on GlobalAABB diagonal, not RayLength.
	// This ensures StepSize is independent of camera position, preventing flickering.
	const float MinStepSize = 1.0;
	float StepSize = max(MinStepSize, GlobalDiagonal / (float)MaxSteps);

	// Blue Noise Jitter:
	// - Spatiotemporal blue noise from View UB (128x128x64 texture)
	// - Blue noise is visually superior to white noise (less perceptible grain)
	// - Temporal variation: different slice each frame for TAA accumulation
	// - Blue noise texture has 64 temporal slices, so we use FrameNumber % 64
	float Jitter = BlueNoiseScalar(PixelCoord, FrameNumber % 64);
	float T = globalTMin + Jitter * StepSize;

	for (int step = 0; step < MaxSteps && Transmittance > 0.01; step++)
	{
		// Fixed step size (no per-step jitter to avoid grain)
		float JitteredStepSize = StepSize;

		float3 WorldPos = RayOrigin + RayDir * T;

		// Sum density from all intersecting volumes at this position
		float TotalDensity = 0.0;
		float3 WeightedColor = float3(0.0, 0.0, 0.0);

		for (uint i = 0; i < numIntersections; i++)
		{
			// Check if current T is within this volume's range
			if (T >= intersections[i].tNear && T <= intersections[i].tFar)
			{
				uint VolumeIdx = intersections[i].VolumeIndex;

				float HoleDensity = GetHoleDensity(WorldPos, VolumeIdx);
				float Density = GetDensityForVolume(WorldPos, VolumeIdx) * HoleDensity;

				if (Density > 0.0001)
				{
					FVolumeGPUData Vol = VolumeDataBuffer[VolumeIdx];
					TotalDensity += Density;
					WeightedColor += Vol.SmokeColor * Density;
				}
			}
		}

		// Beer-Lambert integration (use jittered step size for correct integration)
		if (TotalDensity > 0.0001)
		{
			// Record first hit depth (for particle depth sorting)
			if (FirstHitDepth == 0.0)
			{
				FirstHitDepth = T;  // Distance along ray to first smoke
			}

			float Extinction = TotalDensity * GlobalAbsorption * JitteredStepSize;
			float SampleTransmittance = exp(-Extinction);
			float3 SampleColor = WeightedColor / TotalDensity;

			// Self-shadowing: march toward light to calculate attenuation
			// Calculate distance to exit GlobalAABB, capped by LightMarchingDistance (max limit)
			float LightMarchDist = 0.0;
			float lightTMin, lightTMax;
			if (RayBoxIntersection(WorldPos, LightDirection, GlobalAABBMin, GlobalAABBMax, lightTMin, lightTMax))
			{
				LightMarchDist = lightTMax;
				// Cap at maximum distance for performance (0 = no limit)
				if (LightMarchingDistance > 0.0)
				{
					LightMarchDist = min(LightMarchDist, LightMarchingDistance);
				}
			}

			float LightTransmittance = MarchTowardLight(
				WorldPos,
				LightDirection,
				LightMarchDist,
				LightMarchingSteps,
				LightMarchingExpFactor
			);

			// External shadowing: apply shadow from external objects (trees, buildings, etc.)
			// Uses CSM (Cascaded Shadow Maps) for high-quality directional shadows
			float ExternalShadow = SampleExternalShadow(WorldPos);
			LightTransmittance *= ExternalShadow;

			// Apply self-shadow to base color (ShadowAmbient = minimum brightness)
			float3 LitSampleColor = SampleColor * lerp(ShadowAmbient, 1.0, LightTransmittance);

			// Henyey-Greenstein in-scattering with self-shadowing
			float3 InScatter = float3(0, 0, 0);
			if (ScatterScale > 0.0)
			{
				// Henyey-Greenstein phase function with shadow attenuation
				InScatter = HenyeyGreensteinInScattering(
					RayDir,
					LightDirection,
					LightColor * LightTransmittance,  // Apply self-shadow
					TotalDensity,
					ScatterScale,
					ScatteringAnisotropy
				);

				// Dark smoke absorbs scattered light (black smoke → no blue tint)
				float AlbedoLuminance = dot(SampleColor, float3(0.2126, 0.7152, 0.0722));
				InScatter *= saturate(AlbedoLuminance * 2.0);
			}

			// Combine volume color with in-scattered light
			// Use fixed StepSize for InScatter to avoid grain amplification from jitter
			float3 TotalSampleColor = LitSampleColor + InScatter * StepSize;

			AccumulatedColor += Transmittance * (1.0 - SampleTransmittance) * TotalSampleColor;
			Transmittance *= SampleTransmittance;
		}

		T += JitteredStepSize;
	}

	// Output: Dual Render Target (Albedo + Mask separated)
	// .r = Alpha (opacity), .g = FirstHitDepth (ray distance to first smoke)
	float Alpha = 1.0 - Transmittance;
	SmokeAlbedoTex[PixelCoord] = float4(AccumulatedColor, 1.0);
	SmokeMaskTex[PixelCoord] = float4(Alpha, FirstHitDepth, 0.0, 0.0);
}
