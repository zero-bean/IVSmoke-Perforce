// Volume debug visualization using ray marching through a cube

#include "/Engine/Private/Common.ush"

// ============================================================================
// Parameters
// ============================================================================

Texture3D<float4> VolumeTexture;
SamplerState VolumeSampler;

float4x4 LocalToWorld;
float4x4 WorldToLocal;
float4x4 WorldToClip;
float3 VolumeExtent;
float3 CameraWorldPos;
int NumSteps;
float StepOpacity;

// ============================================================================
// Vertex Shader
// ============================================================================

struct FVertexInput
{
	float3 Position : ATTRIBUTE0;  // Cube vertex position (-1 to 1)
};

struct FVertexOutput
{
	float4 Position : SV_POSITION;
	float3 WorldPos : TEXCOORD0;
	float3 LocalPos : TEXCOORD1;
};

void MainVS(
	in FVertexInput Input,
	out FVertexOutput Output)
{
	// Scale to volume extent
	float3 LocalPos = Input.Position * VolumeExtent;

	// Transform to world space
	float4 WorldPos = mul(float4(LocalPos, 1.0), LocalToWorld);

	Output.Position = mul(WorldPos, WorldToClip);
	Output.WorldPos = WorldPos.xyz;
	Output.LocalPos = Input.Position;  // Keep normalized -1 to 1
}

// ============================================================================
// Ray-Box Intersection
// ============================================================================

// Returns (tNear, tFar) for ray-box intersection, or (-1, -1) if no hit
float2 RayBoxIntersect(float3 RayOrigin, float3 RayDir, float3 BoxMin, float3 BoxMax)
{
	float3 InvDir = 1.0 / RayDir;

	float3 T1 = (BoxMin - RayOrigin) * InvDir;
	float3 T2 = (BoxMax - RayOrigin) * InvDir;

	float3 TMin = min(T1, T2);
	float3 TMax = max(T1, T2);

	float tNear = max(max(TMin.x, TMin.y), TMin.z);
	float tFar = min(min(TMax.x, TMax.y), TMax.z);

	if (tNear > tFar || tFar < 0.0)
	{
		return float2(-1.0, -1.0);
	}

	return float2(max(tNear, 0.0), tFar);
}

// ============================================================================
// Pixel Shader
// ============================================================================

void MainPS(
	in FVertexOutput Input,
	out float4 OutColor : SV_Target0)
{
	// Ray from camera to this pixel's world position
	float3 RayOrigin = CameraWorldPos;
	float3 RayDir = normalize(Input.WorldPos - CameraWorldPos);

	// Transform ray to local space for intersection test
	float3 LocalRayOrigin = mul(float4(RayOrigin, 1.0), WorldToLocal).xyz;
	float3 LocalRayDir = normalize(mul(float4(RayDir, 0.0), WorldToLocal).xyz);

	// Box bounds in local space (using VolumeExtent)
	float3 BoxMin = -VolumeExtent;
	float3 BoxMax = VolumeExtent;

	// Find intersection with volume box
	float2 T = RayBoxIntersect(LocalRayOrigin, LocalRayDir, BoxMin, BoxMax);

	// If ray misses box, discard
	if (T.x < 0.0)
	{
		discard;
	}

	// Ray march through the volume
	float StepSize = (T.y - T.x) / float(NumSteps);
	float3 AccumColor = float3(0.0, 0.0, 0.0);
	float AccumAlpha = 0.0;

	for (int i = 0; i < NumSteps; i++)
	{
		float t = T.x + (float(i) + 0.5) * StepSize;
		float3 LocalSamplePos = LocalRayOrigin + LocalRayDir * t;

		// Convert from local (-VolumeExtent to +VolumeExtent) to UV (0 to 1)
		float3 NormalizedPos = LocalSamplePos / VolumeExtent;
		float3 VolumeUV = NormalizedPos * 0.5 + 0.5;

		// Sample volume
		float4 VoxelData = VolumeTexture.SampleLevel(VolumeSampler, VolumeUV, 0);
		float Density = VoxelData.r;

		// Determine color and alpha
		float3 SampleColor;
		float SampleAlpha;

		if (Density >= 0.99)
		{
			// Full smoke - very faint gray
			SampleColor = float3(0.5, 0.5, 0.5);
			SampleAlpha = StepOpacity * 0.01;
		}
		else
		{
			// Hole - red, intensity based on hole depth
			float HoleIntensity = 1.0 - Density;
			SampleColor = float3(1.0, 0.1, 0.0);
			SampleAlpha = StepOpacity * HoleIntensity * 0.3;
		}

		// Front-to-back compositing
		float OneMinusAccumAlpha = 1.0 - AccumAlpha;
		AccumColor += SampleColor * SampleAlpha * OneMinusAccumAlpha;
		AccumAlpha += SampleAlpha * OneMinusAccumAlpha;

		// Early exit if nearly opaque
		if (AccumAlpha > 0.95)
		{
			break;
		}
	}

	OutColor = float4(AccumColor, AccumAlpha);
}
