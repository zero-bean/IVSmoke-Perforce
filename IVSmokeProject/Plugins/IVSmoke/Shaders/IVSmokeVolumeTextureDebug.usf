#include "/Engine/Private/Common.ush"

Texture3D<float4> SmokeVolumeTexture3D;
SamplerState SmokeVolumeSampler;

int Resolution;
int SliceIndex;
int DebugMode;
float CurrentTime;
float HoleLifeTime;

// Range a certain display screen
float2 DisplayOffset;
float2 DisplaySize;

//------------------------------------------------------------------------------
// Pixel Shader - Volume Slice Debug Visualization
//------------------------------------------------------------------------------
void MainPS(float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	// Calculate normalized screen position (account for viewport offset)
	float2 ScreenUV = (SvPosition.xy - View.ViewRectMin.xy) * View.ViewSizeAndInvSize.zw;

	// Check if pixel is within debug display area
	float2 LocalUV = (ScreenUV - DisplayOffset) / DisplaySize;

	if (LocalUV.x < 0.f || LocalUV.x > 1.f || LocalUV.y < 0.f || LocalUV.y > 1.f)
	{
		discard;
	}

	// Calculate 3D UV for volume texture sampling
	float3 VolumeUV;
	VolumeUV.x = LocalUV.x;
	VolumeUV.y = LocalUV.y;
	VolumeUV.z = (SliceIndex + 0.5f) / float(Resolution);

	// Sample volume texture
	float4 VoxelData = SmokeVolumeTexture3D.SampleLevel(SmokeVolumeSampler, VolumeUV, 0);

	float Density = VoxelData.r;
	float CreationTime = VoxelData.g;
	// BA is reserved

	float Age = CurrentTime - CreationTime;
	float LifeRatio = saturate(1.f - (Age / HoleLifeTime));

	float4 FinalColor = float4(0,0,0,1);

	if (DebugMode == 0) // Only Debug about Hole
	{
		FinalColor.rgb = Density.xxx;
	}
	else if (DebugMode == 1) // Only Debug about Time
	{
		if (Density < 1.f && CreationTime > 0.f)
		{
			FinalColor.r = LifeRatio;
			FinalColor.g = 1.f - LifeRatio;
			FinalColor.b = 0.f;
		}
		else
		{
			FinalColor.rgb = float3(0.2f, 0.2f, 0.2f);
		}
	}
	else if (DebugMode == 2) // Debug about Density + Time
	{
		// Background is density grayscale, holes are colored by age
		if (Density < 1.0f && CreationTime > 0.0f)
		{
			FinalColor.r = LifeRatio;
			FinalColor.g = 1.0f - LifeRatio;
			FinalColor.b = 0.2f;
		}
		else
		{
			// Full smoke - show as semi-transparent white
			FinalColor.rgb = float3(0.8f, 0.8f, 0.8f);
		}
	}

	// Add grid lines for voxel boundaries
	float2 VoxelUV = LocalUV * float(Resolution);
	float2 GridLine = abs(frac(VoxelUV) - 0.5f);
	float GridIntensity = 1.0f - saturate(min(GridLine.x, GridLine.y) * 20.0f);
	FinalColor.rgb = lerp(FinalColor.rgb, float3(0.3f, 0.3f, 0.5f), GridIntensity * 0.3f);

	// Border
	float BorderWidth = 0.01f;
	if (LocalUV.x < BorderWidth || LocalUV.x > 1.0f - BorderWidth ||
	  LocalUV.y < BorderWidth || LocalUV.y > 1.0f - BorderWidth)
	{
		FinalColor.rgb = float3(0.0f, 1.0f, 1.0f);
	}

	OutColor = FinalColor;
}
