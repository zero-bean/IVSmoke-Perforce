// IVSmokeHoleCarveCS.usf - Compute shader for carving holes into smoke volume

#include "/Engine/Public/Platform.ush"

// ============================================================================
// Output
// ============================================================================

RWTexture3D<float4> VolumeTexture;

// ============================================================================
// Input Buffers
// ============================================================================

struct FHoleGPU
{
	// ============================================================================
	// Dynamic
	// ============================================================================
	//common
	float3 Position;
	float NormalizedAge;
	
	//only grenade

	//only bullet
	float3 EndPosition;
	float Dynamic_BulletPadding;

	// ============================================================================
	// Preset
	// ============================================================================
	// Common
	int HoleType; // 0 = Bullet (cone), 1 = Explosion (sphere)
	float Radius;
	float Lifetime;
	float EdgeSoftness;

	//only grenade
	float ExtensionTime; //0.07f * 2.4f;
	float DensityExtDelayTime;
	float2 Preset_GrenadePadding;
	
	//only bullet
	float EndRadius;
	float DensityMultiplier;
	float2 Preset_BulletPadding;
};

StructuredBuffer<FHoleGPU> HoleBuffer;

// ============================================================================
// Uniforms
// ============================================================================

float3 VolumeMin;
float3 VolumeMax;
int3 Resolution;
int NumHoles;

// ============================================================================
// SDF Functions
// ============================================================================

/**
 * @brief Signed distance to a cone defined by two endpoints and radii.
 *        This creates a capsule-like shape that tapers from one radius to another.
 *
 * @param P         Query point
 * @param A         Start position
 * @param B         End position
 * @param RadiusA   Radius at start
 * @param RadiusB   Radius at end
 * @return Signed distance (negative = inside)
 */
float ConeSDF(float3 P, float3 A, float3 B, float RadiusA, float RadiusB)
{
	float3 AB = B - A;
	float3 AP = P - A;

	float LengthAB = length(AB);
	if (LengthAB < 0.0001)
	{
		// Degenerate case: A and B are the same point
		return length(P - A) - RadiusA;
	}

	float3 Dir = AB / LengthAB;

	// Project P onto line AB
	float t = dot(AP, Dir);

	// Clamp to segment [0, LengthAB]
	float tClamped = saturate(t / LengthAB);

	// Interpolate radius along the cone
	float RadiusAtT = lerp(RadiusA, RadiusB, tClamped);

	// Closest point on the axis
	float3 ClosestPoint = A + Dir * (tClamped * LengthAB);

	// Distance from P to the cone surface
	float DistToAxis = length(P - ClosestPoint);

	return DistToAxis - RadiusAtT;
}

// ============================================================================
// Utility Functions
// ============================================================================

float3 GetWorldPos(int3 VoxelCoord)
{
	float3 NormalizedPos = (float3(VoxelCoord) + 0.5) / float3(Resolution);
	return VolumeMin + NormalizedPos * (VolumeMax - VolumeMin);
}
float3 GetUVW(float3 WorldPos)
{
	return (WorldPos - VolumeMin) / (VolumeMax - VolumeMin);
}

// ============================================================================
// Explosion Animation
// ============================================================================
/**
 * @brief Calculate explosion hole
 * @param CurOffset		Vector from hole center to current point
 * @param uvw			uvw (0 ~ 1)
 * @param Radius        Hole radius
 * @param NormalizedAge Hole lifetime progress (0=new, 1=expired)
 * @return Hole distortion uvw offset
 */
float4 CalculateExplosionStrength(float3 CurOffset, float3 uvw, int HoleIdx, out float GrenadeFade, out float FadeEndTime)
{
	FHoleGPU HoleData = HoleBuffer[HoleIdx];
	float CurTime = HoleData.NormalizedAge * HoleData.Lifetime;

	float3 Dir = normalize(CurOffset);
	float Dis = length(CurOffset);
	float VolumeHeight = VolumeMax.z - VolumeMin.z;
	float AlphaHeight = 100.0f;
	float GrenadeStartTime = -HoleData.Lifetime * HoleData.NormalizedAge;
	
	float3 Offset = float3(0, 0, 0);
	float Density = 1;
	float HeightDensity = 0;

	GrenadeFade = saturate(CurTime / HoleData.ExtensionTime);
	FadeEndTime = GrenadeStartTime + HoleData.ExtensionTime;
	
	if (CurTime < HoleData.ExtensionTime)
	{
		float ExtensionNormalizedTime = CurTime / HoleData.ExtensionTime;
		const float DistortionMax = 0.7f * HoleData.Radius;

		float Distortion = (1 - pow(saturate(Dis / HoleData.Radius), 1.5f)) * DistortionMax * ExtensionNormalizedTime;
		if (Dis < HoleData.Radius)
		{
			Distortion += DistortionMax * ExtensionNormalizedTime * 0.1f;
		}
		Offset = -Dir * Distortion;

		//같은자리 두번 던지면 바닥 잔여연기 두번 퍼지는 아티팩트 눈에띔 그거 수정용
		if (uvw.z * VolumeHeight < AlphaHeight)
		{
			Offset = float3(0, 0, 0);
		}

		float Bottom = max(HoleData.ExtensionTime - HoleData.DensityExtDelayTime, 0.001f);
		float DensityExtNormalizedTime = saturate((CurTime - HoleData.DensityExtDelayTime) / Bottom);
		
		float CurRadius = HoleData.Radius * pow(DensityExtNormalizedTime, 1.5f);
		Density = saturate((Dis - CurRadius) / (CurRadius * max(0.05f, HoleData.EdgeSoftness)));
	}
	else
	{	
		//남은 시간 정규화
		float Bottom = max(HoleData.Lifetime - HoleData.ExtensionTime, 0.001f);
		float RemainderNormalizedTime = saturate((CurTime - HoleData.ExtensionTime) / Bottom);

		//확장 마지막 density
		float LastDensity = saturate((Dis - HoleData.Radius) / (HoleData.Radius * max(0.05f, HoleData.EdgeSoftness)));

		float CurRadius = RemainderNormalizedTime * HoleData.Radius;
		float CurDensity = saturate((Dis + CurRadius - HoleData.Radius) / HoleData.Radius);
		
		Density = lerp(LastDensity, CurDensity, RemainderNormalizedTime);
		AlphaHeight = AlphaHeight + pow(RemainderNormalizedTime, 2.5f) * (VolumeHeight - AlphaHeight);
	}

	float AlphaHeightUV_Z = max(0.01f, AlphaHeight / VolumeHeight);
	HeightDensity = pow((1 - saturate(uvw.z / AlphaHeightUV_Z)), 1.2f);
	
	Density = max(Density, HeightDensity);
	return float4(Offset, Density);
}
// ============================================================================
// Main Compute Shader
// ============================================================================

[numthreads(THREADGROUP_SIZEX, THREADGROUP_SIZEY, THREADGROUP_SIZEZ)]
void MainCS(uint3 DTid : SV_DispatchThreadID)
{
	// Calculate actual voxel coordinate based on update region
	int3 VoxelCoord = int3(DTid);

	// Bounds check
	if (any(VoxelCoord >= Resolution))
	{
		return;
	}

	float3 WorldPos = GetWorldPos(VoxelCoord);
	float3 uvw = GetUVW(WorldPos);
	
	// Start with full density
	float Density = 1.0;

	// Evaluate all holes
	float4 GrenadeResult = float4(0, 0, 0, 1);
	float BulletResult = 1.0f;

	float BulletFadeFactor = 0.0f;
	float FadeEndTime = 0.0f;
	for (int HoleIdx = 0; HoleIdx < NumHoles; HoleIdx++)
	{
		FHoleGPU Hole = HoleBuffer[HoleIdx];

		// Skip fully faded holes
		if (Hole.NormalizedAge >= 1.0)
		{
			continue;
		}

		float HoleDensity = 0.0f;

		if(Hole.HoleType == 1)
		{
			//grenade
			float3 CurOffset = WorldPos - Hole.Position;
			float CurGrenadeFade = 0.0f;
			float CurFadeEndTime = 0.0f;
			float4 HoleInfo = CalculateExplosionStrength(CurOffset, uvw, HoleIdx, CurGrenadeFade, CurFadeEndTime);
			GrenadeResult.a = min(GrenadeResult.a, HoleInfo.a);
			GrenadeResult.rgb += HoleInfo.rgb;

			if (CurGrenadeFade > BulletFadeFactor)
			{
				BulletFadeFactor = CurGrenadeFade;
				FadeEndTime = CurFadeEndTime;
			}
		}
		else
		{
			//bullet
			float Dist = ConeSDF(WorldPos, Hole.Position, Hole.EndPosition, Hole.Radius, Hole.EndRadius);

			if (Dist < 0.0)
			{
				float EdgeWidth = Hole.Radius * saturate(Hole.EdgeSoftness + 0.1);
				float Falloff = saturate(-Dist / EdgeWidth);
				float FadeOut = 1.0 - pow(Hole.NormalizedAge, 3.5f);
				HoleDensity = Falloff * Hole.DensityMultiplier * FadeOut;
			}

			float CurBulletDensity = HoleDensity;
			if (BulletFadeFactor > 0)
			{
				float BulletStartTime = -Hole.Lifetime * Hole.NormalizedAge;
				if (BulletStartTime < FadeEndTime)
				{
					CurBulletDensity = saturate(CurBulletDensity * (1 - BulletFadeFactor));
				}
			}
			CurBulletDensity = 1.0 - saturate(CurBulletDensity);
			BulletResult = min(BulletResult, CurBulletDensity);
		}
	}

	//Density = saturate(Density);
	VolumeTexture[VoxelCoord] = float4(GrenadeResult.rgb, min(GrenadeResult.a, BulletResult));
}
