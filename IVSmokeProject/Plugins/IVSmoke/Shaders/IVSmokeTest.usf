#include "/Engine/Private/Common.ush"

// PS parameters
float4 TintColor;

// CS parameters
float2 ViewportSize;
Texture2D SceneColorTexture;
SamplerState SceneColorSampler;
RWTexture2D<float4> OutputTexture;

// Thread group size (defined from C++)
#ifndef THREADGROUP_SIZE_X
#define THREADGROUP_SIZE_X 8
#endif
#ifndef THREADGROUP_SIZE_Y
#define THREADGROUP_SIZE_Y 8
#endif

//------------------------------------------------------------------------------
// Pixel Shader - Simple tint test (RED by default)
//------------------------------------------------------------------------------
void MainPS(
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	OutColor = TintColor;
}

//------------------------------------------------------------------------------
// Compute Shader - Simple tint test (BLUE by default)
//------------------------------------------------------------------------------
[numthreads(THREADGROUP_SIZE_X, THREADGROUP_SIZE_Y, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint2 PixelCoord = DispatchThreadId.xy;

	// Bounds check
	if (PixelCoord.x >= (uint)ViewportSize.x || PixelCoord.y >= (uint)ViewportSize.y)
	{
		return;
	}

	float2 UV = (float2(PixelCoord) + 0.5f) / ViewportSize;

	// Read existing scene color
	float4 SceneColor = SceneColorTexture.SampleLevel(SceneColorSampler, UV, 0);

	// Alpha blend tint over scene
	float4 FinalColor;
	FinalColor.rgb = lerp(SceneColor.rgb, TintColor.rgb, TintColor.a);
	FinalColor.a = SceneColor.a;

	OutputTexture[PixelCoord] = FinalColor;
}
